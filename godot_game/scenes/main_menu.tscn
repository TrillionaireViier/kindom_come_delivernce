[gd_scene load_steps=2 format=3 uid="uid://kcd_main_menu"]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_menu"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer"]
custom_minimum_size = Vector2(520, 0)
layout_mode = 2
theme_override_constants/separation = 14

[node name="TitleLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.85, 0.45, 1)
theme_override_font_sizes/font_size = 40
text = "KINGDOM COME"
horizontal_alignment = 1

[node name="SubTitleLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.25, 0.2, 1)
theme_override_font_sizes/font_size = 20
text = "DELIVERANCE • BOHEMIA 1403"
horizontal_alignment = 1

[node name="MottoLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.7, 0.6, 1)
theme_override_font_sizes/font_size = 14
text = "\"Jesus Christ be praised! Henry's come to see us!\""
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="CenterContainer/VBoxContainer"]
layout_mode = 2

[node name="CombatButton" type="Button" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "⚔️ Enter Bohemia (Combat Arena)"

[node name="LockpickButton" type="Button" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "🔓 Rattay Lockpicking Training"

[node name="GrindstoneButton" type="Button" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "🔨 Blacksmith Grindstone (Sharpen Blade)"

[node name="QuitButton" type="Button" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
text = "Exit to Desktop"

[connection signal="pressed" from="CenterContainer/VBoxContainer/CombatButton" to="." method="_on_start_combat_pressed"]
[connection signal="pressed" from="CenterContainer/VBoxContainer/LockpickButton" to="." method="_on_lockpick_training_pressed"]
[connection signal="pressed" from="CenterContainer/VBoxContainer/GrindstoneButton" to="." method="_on_grindstone_pressed"]
[connection signal="pressed" from="CenterContainer/VBoxContainer/QuitButton" to="." method="_on_quit_pressed"]
